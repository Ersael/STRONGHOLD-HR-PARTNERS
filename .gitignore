# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# artefactos de un problema de locking del sandbox de desarrollo (seguro de borrar)
/_sandbox_cleanup_ignore/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# artefactos de compilar manualmente scripts/smoke-test-scoring.ts con un bundler
/dist-smoke/

__pycache__/
*.pyc
